# SEC EDGAR Config
SEC_USER_AGENT="FinancialAIAssistant admin@domain.com"
SEC_RATE_LIMIT_PER_SEC=10

# Database Config (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financial_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_db

# ChromaDB Config
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=sec_10k_filings

# LLM Config
# Provider options: openai, gemini, local
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here

# App Server
PORT=8000
STREAMLIT_PORT=8501
